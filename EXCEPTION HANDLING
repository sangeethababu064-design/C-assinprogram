EXCEPTION HANDLING:
#include <iostream>
using namespace std;

int main() {
    int num, den;
    float result;

    cout << "Enter numerator: ";
    cin >> num;
    cout << "Enter denominator: ";
    cin >> den;

    try {
        if (den == 0) {
            throw "Division by zero not allowed!";
        }
        result = (float)num / den;
        cout << "Result: " << result << endl;
    }
    catch (const char* msg) {
        cout << "Error: " << msg << endl;
    }

    return 0;
}
