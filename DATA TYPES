#include <iostream>
using namespace std;

int main() {
    int i;
    float f;
    double d;
    char c;
    bool b;

    cout << "Enter int value: ";
    cin >> i;

    cout << "Enter float value: ";
    cin >> f;

    cout << "Enter double value: ";
    cin >> d;

    cout << "Enter char value: ";
    cin >> c;

    cout << "Enter bool value (0 or 1): ";
    cin >> b;

    cout << "\n--- Display Values ---\n";
    cout << "Int    = " << i << endl;
    cout << "Float  = " << f << endl;
    cout << "Double = " << d << endl;
    cout << "Char   = " << c << endl;
    cout << "Bool   = " << b << endl;

    return 0;
}
